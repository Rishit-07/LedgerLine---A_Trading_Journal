FIREBASE_PROJECT_ID=ledger-line-d2e8c
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional calendar feeds. Use credentials with permission to display the data to Ledgerline users.
# The public U.S. BEA release schedule works without credentials.
TRADING_ECONOMICS_KEY=
FMP_CALENDAR_KEY=
# Optional FMP tickers for company and sector-ETF news, comma separated.
FMP_CATALYST_SYMBOLS=
UPSTOX_CALENDAR_TOKEN=
# Comma-separated Upstox NSE index names, for example Nifty 50,Nifty Bank.
UPSTOX_EXPIRY_SYMBOLS=

# Optional AI Coach. The server sends the listed journal context after the member opts in.
# AI Coach checks OpenRouter, Groq, then OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_COACH_MODEL=inclusionai/ling-3.2-flash:free
GROQ_API_KEY=
GROQ_COACH_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
LEDGERLINE_COACH_MODEL=

# Use true on the web backend after enabling the Neon scheduled Function.
STREAK_NEON_SCHEDULE=false

# Optional welcome email settings. Set APP_URL and one sender's credentials.
APP_URL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=

# Historical NSE/BSE candles. Supply a token enabled for the app's intended display use.
UPSTOX_HISTORY_TOKEN=

# Optional: the only email allowed to review mentor applications.
# REVIEWER_EMAIL=
# Set to true when the API runs behind a reverse proxy so rate limits use the real client address.
# TRUST_PROXY=true

# --- Optional hardening (all off until set) ---
# Require an authenticator-app code (Firebase two-step sign-in) for the reviewer account.
# REQUIRE_REVIEWER_MFA=true
# Reject API calls without a valid Firebase App Check token. Turn on only after the website sends tokens.
# APP_CHECK_ENFORCE=true
# Shared rate limits across servers (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Error tracking (Sentry DSN). Only error names and stack frames are sent, never request data.
# SENTRY_DSN=
# Encrypt billing address and GST number. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY=
# Newsletter. Postal address is required by law in every email footer; sending is off until it is set.
# NEWSLETTER_POSTAL_ADDRESS=
# Signs confirm and manage links (falls back to FIELD_ENCRYPTION_KEY).
# NEWSLETTER_SECRET=
# Resend webhook signing secret (whsec_...) for bounce and complaint events.
# NEWSLETTER_WEBHOOK_SECRET=
