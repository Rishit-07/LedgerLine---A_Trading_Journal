# Optional: Firebase App Check (reCAPTCHA Enterprise site key). Leave empty to keep it off.
# VITE_APPCHECK_SITE_KEY=
# Local development only: a debug token registered in the Firebase console.
# VITE_APPCHECK_DEBUG_TOKEN=
# Cloudflare Turnstile site key (public). Pair it with TURNSTILE_SECRET_KEY on the server, or leave both empty.
# VITE_TURNSTILE_SITE_KEY=
